# Server-side credentials. Copy to .env.local and fill in locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
QLOO_API_KEY=
# Set from the Qloo access instructions after verification.
QLOO_API_URL=https://hackathon.api.qloo.com
PORT=4317
# Added automatically by Convex CLI after connecting the CareTable deployment.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Server-only Resend configuration, also set on the Convex deployment.
RESEND_API_KEY=
RESEND_FROM=
# Public UI notice while Resend uses its restricted testing sender.
NEXT_PUBLIC_EMAIL_MODE=test
